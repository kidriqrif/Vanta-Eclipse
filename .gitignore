# --- Unity ---------------------------------------------------------------
# Regenerated by the editor on open. Library/ alone runs to gigabytes, and the
# Stop hook does `git add -A` and pushes to a PUBLIC remote every turn, so
# these have to be ignored BEFORE Unity is first opened, not after.
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/
[Mm]emoryCaptures/
[Rr]ecordings/
# Solution and project files, regenerated from the asmdefs and packages
*.csproj
*.unityproj
*.sln
*.suo
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.opendb
*.VC.db
.vs/
.vscode/
# Unity crash and stack-trace dumps
sysinfo.txt
crashlytics-build.properties
*.stackdump

# --- Godot (being retired; see PORT.md) -----------------------------------
# Godot 4 generated cache and import data (rebuilt automatically on project open)
.godot/

# export_presets.cfg is deliberately TRACKED — it is build configuration
# (architecture, SDK levels, permissions, exclude filters, icons, package
# name), and keeping it untracked is exactly how the release checklist came
# to assert settings that no file specified. Since Godot 4.4 the secrets live
# in export_credentials.cfg instead, so that is what gets ignored.
export_credentials.cfg

# Android build template (installed locally, never committed)
android/

# Keystores and signing secrets must NEVER be committed.
#
# This list is deliberately wider than the two extensions Godot's own docs
# mention, because the Stop hook runs `git add -A` and pushes to a PUBLIC
# repository on every turn. Nothing here is reviewed before it leaves the
# machine, so the ignore list — not vigilance — is the only thing standing
# between a credential and the internet. Every pattern below is a file the
# RELEASE-CHECKLIST work is about to create.
*.keystore
*.jks
*.p12
*.pfx
*.pem
*.pk8
*.pepk
*.der
key.properties
keystore.properties
# Play Console / Firebase / ad-network service credentials
google-services.json
play-service-account*.json
service-account*.json
# Local environment files
.env
.env.*

# OS junk
.DS_Store
Thumbs.db
desktop.ini

# Personal Claude Code settings (the auto-push hook is a local workflow,
# not something a fresh clone should inherit)
.claude/settings.local.json

# Screenshots from tools/screenshot_run.sh
.godot-shots/

# Python bytecode from the tools/ checkers
__pycache__/
*.pyc

# graphify knowledge-graph output — generated, large, and rebuilt on demand.
# Explicitly ignored because the Stop hook auto-commits and pushes this repo
# to a PUBLIC remote, so anything left in the tree ships whether or not it was
# meant to.
graphify-out/

# Unity build output. `build/` is already ignored above for the Godot exports;
# this note is here so the reason survives the Godot tree's removal — the APK
# and AAB are 27 MB artifacts rebuilt by tools, never reviewed, and the Stop
# hook pushes to a public remote every turn.

# IL2CPP / Bee build intermediates. Unity writes these into the PROJECT ROOT,
# not under Library/, so none of the Unity entries above catch them — 55 files
# of CMake caches and ninja graphs were committed and pushed to the public
# remote before this line existed.
.utmp/
Logs/
UserSettings/
