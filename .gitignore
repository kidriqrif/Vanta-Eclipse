# Godot 4 generated cache and import data (rebuilt automatically on project open)
.godot/

# Godot exports and build output
build/
export_presets.cfg

# Android build template (installed locally, never committed)
android/

# Keystores and signing secrets must NEVER be committed
*.keystore
*.jks

# OS junk
.DS_Store
Thumbs.db
desktop.ini

# Personal Claude Code settings (the auto-push hook is a local workflow,
# not something a fresh clone should inherit)
.claude/settings.local.json
